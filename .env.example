# Copy to .env and fill values before running scripts/bootstrap.sh.

BASE_DOMAIN=example.internal
GITOPS_REPO_URL=https://github.com/you/kubernetes.git
GITOPS_TARGET_REVISION=main

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=terenceliu
GITHUB_ALLOWED_EMAIL=you@example.com
ARGO_DEX_CLIENT_SECRET=
KUBEFLOW_OIDC_CLIENT_SECRET=
GITEA_OIDC_CLIENT_SECRET=

GITEA_ADMIN_USERNAME=gitea_admin
GITEA_ADMIN_PASSWORD=
GITEA_RUNNER_REGISTRATION_TOKEN=
OPENSANDBOX_API_KEY=

DEX_LOCAL_ADMIN_EMAIL=admin@example.com
DEX_LOCAL_ADMIN_USERNAME=admin
# Generate with: htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
DEX_LOCAL_ADMIN_BCRYPT_HASH=

ARGO_ADMIN_PASSWORD_BCRYPT_HASH=

JUICEFS_NAME=juicefs
JUICEFS_META_PASSWORD=
JUICEFS_META_HOST=192.168.2.153
JUICEFS_STORAGE=gluster
JUICEFS_BUCKET=192.168.2.153/gv0/juicefs-objects
JUICEFS_ENVS="{JFS_DROP_OSCACHE: 1}"
JUICEFS_SECRET_NAME=juicefs-sc-secret
JUICEFS_SECRET_NAMESPACE=kube-system
